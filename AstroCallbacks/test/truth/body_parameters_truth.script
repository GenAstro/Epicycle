% Reference values for test_correctness_body_parameters.jl, from GMAT R2026a.
%
% Three Earth orbits at 20 Mar 2024 12:00:00 UTC, each a Cartesian state in EarthMJ2000Eq, with
% Earth's GM, equatorial radius and flattening set to the values Epicycle uses. GMAT writes
% body_parameters_truth.txt to its output folder; the numbers are copied into the test. The Sun
% comes from the same SPICE kernel Epicycle loads by default; copy epicycle_de440_1950-2100.bsp
% from AstroUniverse's kernel folder (see download_spice_kernel) into GMAT's
% data/planetary_ephem/spk folder before running.
% Run with GmatConsole.exe body_parameters_truth.script.

GMAT SolarSystem.EphemerisSource = 'SPICE';
GMAT SolarSystem.SPKFilename = '../data/planetary_ephem/spk/epicycle_de440_1950-2100.bsp';

GMAT Earth.Mu = 398600.4418;
GMAT Earth.EquatorialRadius = 6378.137;
GMAT Earth.Flattening = 0.00335281;

Create Spacecraft leo molniya polar;
GMAT leo.DateFormat = UTCGregorian;
GMAT leo.Epoch = '20 Mar 2024 12:00:00.000';
GMAT leo.CoordinateSystem = EarthMJ2000Eq;
GMAT molniya.DateFormat = UTCGregorian;
GMAT molniya.Epoch = '20 Mar 2024 12:00:00.000';
GMAT molniya.CoordinateSystem = EarthMJ2000Eq;
GMAT polar.DateFormat = UTCGregorian;
GMAT polar.Epoch = '20 Mar 2024 12:00:00.000';
GMAT polar.CoordinateSystem = EarthMJ2000Eq;

Create ReportFile truth;
GMAT truth.Filename = 'body_parameters_truth.txt';
GMAT truth.Precision = 16;
GMAT truth.WriteHeaders = true;

BeginMissionSequence;

leo.X = 7000.0
leo.Y = 300.0
leo.Z = 1200.0
leo.VX = -0.4
leo.VY = 7.4
leo.VZ = 0.9

molniya.X = 4637.031328726552
molniya.Y = 178.53697947901998
molniya.Z = -5679.055240387162
molniya.VX = 6.252424682730313
molniya.VY = 6.928411997008257
molniya.VZ = 2.5730558589825416

polar.X = 1731.6965430023222
polar.Y = -2999.386395771405
polar.Z = -7427.270441381914
polar.VX = -3.0611710106575205
polar.VY = 5.302103721115798
polar.VZ = -2.5783940176845728

Report truth leo.Earth.RadApo leo.Earth.RadPer leo.Earth.SemilatusRectum leo.Earth.C3Energy leo.Earth.BetaAngle
Report truth molniya.Earth.RadApo molniya.Earth.RadPer molniya.Earth.SemilatusRectum molniya.Earth.C3Energy molniya.Earth.BetaAngle
Report truth polar.Earth.RadApo polar.Earth.RadPer polar.Earth.SemilatusRectum polar.Earth.C3Energy polar.Earth.BetaAngle
